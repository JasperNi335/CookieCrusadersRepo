{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Pico Debug (OpenOCD in PATH/ENV)",
        "type": "cortex-debug",
        "request": "launch",
        "servertype": "openocd",
        "cwd": "${workspaceFolder}",
        "executable": "${workspaceFolder}/build/kws_features.elf",
        "device": "RP2040",
        "serverpath": "${env:OPENOCD_PATH}/openocd.exe",
        "configFiles": [
          "interface/cmsis-dap.cfg",
          "target/rp2040.cfg"
        ],
        "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/RP2040.svd",
        "gdbPath": "${env:ARM_GCC_PATH}/bin/arm-none-eabi-gdb.exe",
        "runToEntryPoint": "main",
        "openOCDLaunchCommands": [
          "adapter speed 5000"
        ]
      },
      {
        "name": "Pico Debug (External OpenOCD, gdbTarget=localhost:3333)",
        "type": "cortex-debug",
        "request": "launch",
        "servertype": "external",
        "cwd": "${workspaceFolder}",
        "executable": "${workspaceFolder}/build/kws_features.elf",
        "device": "RP2040",
        "gdbTarget": "localhost:3333",
        "gdbPath": "${env:ARM_GCC_PATH}/bin/arm-none-eabi-gdb.exe",
        "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/RP2040.svd",
        "runToEntryPoint": "main"
      }
    ]
}  