{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bootstrap dev env",
      "type": "shell",
      "command": "python",
      "args": ["tools/bootstrap.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": []
    },

    {
      "label": "Firmware: Flash MicroPython UF2",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\tools\\flash_uf2.ps1",
        "-Py", "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": []
    },

    {
      "label": "Device: Sync to Pico",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\tools\\sync_to_pico.ps1",
        "-Py", "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": []
    },

    {
      "label": "Device: Clean & Reboot",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\tools\\clean_device.ps1",
        "-Py", "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": []
    },

    {
      "label": "Device: REPL (mpremote)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "mpremote", "repl"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": []
    },

    {
      "label": "Host: List COM ports",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["tools/list_ports.py"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": []
    },

    {
      "label": "Ensure venv (auto)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\tools\\ensure_venv.ps1",
        "-Workspace", "${workspaceFolder}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": []
    },

    {
      "label": "Auto: Ensure venv + Deploy on open",
      "dependsOn": [
        "Ensure venv (auto)",
        "Device: Sync to Pico"
      ],
      "dependsOrder": "sequence",
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    }
  ]
}