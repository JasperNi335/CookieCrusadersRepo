{
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.buildDirectory": "${workspaceFolder}/build_ninja",
  "cmake.generator": "Ninja",

  "cmake.configureOnOpen": true,
  "cmake.buildOnOpen": true,
  "cmake.buildTarget": "kws_features.uf2",

  "workbench.colorTheme": "Quiet Light",
  "files.autoSave": "afterDelay",

  "raspberry-pi-pico.python3Path": "c:\\Program Files\\Python313\\python.exe",

  "workbench.editorAssociations": [
    { "viewType": "vscode.markdown.preview.editor", "filenamePattern": "*.copilotmd" },
    { "viewType": "default", "filenamePattern": "*.uf2" }
  ]
}